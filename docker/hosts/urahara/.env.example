# urahara: copy to .env and fill in. Variables are shared across services
# unless prefixed with the service name (see Conventions in the README).

# --- Global ---
TZ=America/Sao_Paulo
DB_USER=
DB_PASSWORD=
# also the Vaultwarden SMTP sender/login (Gmail account of the app password)
ADMIN_EMAIL=
ADMIN_USER=
ADMIN_PASSWORD=
NODE_HOSTNAME=urahara

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Cloudflare ---
CF_ACCOUNT_ID=
CF_ZONE_ID=
CF_API_TOKEN=
CF_TUNNEL_TOKEN=

# --- Dockflare ---
DOCKFLARE_AGENT_API_KEY=

# --- GitHub ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Firefly III ---
FIREFLY_APP_KEY=
# used by the Homepage widget
FIREFLY_API_TOKEN=

# --- Immich ---
# used by the Homepage widget
IMMICH_API_KEY=

# --- Paperless-ngx ---
PAPERLESS_SECRET_KEY=
PAPERLESS_DBPASS=
PAPERLESS_URL=https://paperless.lan.thalespm.me
PAPERLESS_API_KEY=

# --- Unpoller ---
UP_UNIFI_DEFAULT_URL=
UP_UNIFI_DEFAULT_USER=
UP_UNIFI_DEFAULT_PASS=
UP_UNIFI_DEFAULT_VERIFY_SSL=false
UP_UNIFI_DEFAULT_SAVE_DPI=true
UP_INFLUXDB_DISABLE=true
UP_PROMETHEUS_DISABLE=false

# --- N8N ---
N8N_API_KEY=

# --- Restic ---
RESTIC_PASSWORD=

# --- Vaultwarden ---
VAULTWARDEN_ADMIN_TOKEN=

# --- UniFi ---
UNIFI_PASSWORD=

# --- QNAP ---
QNAP_USER=
QNAP_PASSWORD=

# --- Healthchecks ---
HEALTHCHECKS_SECRET_KEY=
HEALTHCHECKS_API_KEY=

# --- Docker Hub ---
DOCKERHUB_PAT=

# --- Keepalived ---
KEEPALIVED_VRRP_PASS=

# --- Pi-hole ---
PIHOLE_STATIC_IP=

# --- Grafana Alloy ---
LOKI_URL=
HOSTNAME_LABEL=

# --- Vikunja ---
VIKUNJA_JWT_SECRET=

# --- Crowdsec ---
CROWDSEC_BOUNCER_KEY=

# --- Tailscale ---
TAILSCALE_AUTH_KEY=
# optional TS_DEBUG_FIREWALL_MODE override (empty = auto)
TAILSCALE_FIREWALL_MODE=

# --- Tandoor ---
TANDOOR_SECRET_KEY=

# --- Komodo Periphery (agent for the Core on zangetsu) ---
KOMODO_SERVER_NAME=urahara
KOMODO_PERIPHERY_CORE_ADDRESS=ws://192.168.15.214:9120
KOMODO_PASSKEY=

# --- Watchtower ---
# shoutrrr. Must be generic://, never generic+https://: with the generic+
# prefix every query variable is escaped and forwarded to the server instead
# of configuring shoutrrr, so ?template=json is ignored and the payload
# arrives as text/plain, which the n8n workflow rejects. generic:// already
# defaults to https. Form:
# generic://n8n.lan.thalespm.me/webhook/homelab-notify?template=json
WATCHTOWER_NOTIFICATION_URL=
WATCHTOWER_HTTP_API_TOKEN=
WATCHTOWER_PORT=
# Offset from zangetsu's default (03:30) so both hosts don't burst
# auth.docker.io's token endpoint at the same second (429s, 2026-11-27).
WATCHTOWER_SCHEDULE=0 45 3 * * *

# --- Evolution API ---
EVOLUTION_DBUSER=
EVOLUTION_DBPASS=
EVOLUTION_API_KEY=
N8N_WEBHOOK_SECRET=

# --- qBittorrent exporter ---
QBITTORRENT_EXPORTER_API_KEY=

# --- Calnode ---
# generate both with: openssl rand -hex 32
# without them the app uses an ephemeral key and loses stored credentials on restart
CALNODE_ENCRYPTION_KEY=
CALNODE_RECOVERY_SECRET=
