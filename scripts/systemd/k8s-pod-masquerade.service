[Unit]
Description=SNAT for Kubernetes pod traffic leaving this node (zangetsu only)
Documentation=https://github.com/thales-machado/platform-engineering-labs/blob/main/k8s/local/docs/postmortems/0009-no-pod-egress-on-zangetsu.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# bash explicitly: every script in this repository is committed with mode
# 644, so systemd cannot exec one directly (status=203/EXEC).
ExecStart=/bin/bash /opt/homelab/scripts/networking/k8s-pod-masquerade.sh

[Install]
WantedBy=multi-user.target
